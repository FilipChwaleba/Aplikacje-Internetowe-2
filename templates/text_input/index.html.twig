{% extends 'base.html.twig' %}

{% block title %}Hello TextInputController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">

    <h1>Text Submission Form</h1>
    {{ form_start(form) }}
    {{ form_widget(form) }}
    <button type="submit">Submit</button>
    {{ form_end(form) }}

    {% if submittedText is not empty %}
        <h2>Submitted text:</h2>
        <p>{{ submittedText }}</p>
        <p>{{ submittedText|raw }}</p>

    {% endif %}

    This friendly message is coming from:
    <ul>
        <li>Your controller at <code>C:/Users/cf55611/ai2/pogodynka/src/Controller/TextInputController.php</code></li>
        <li>Your template at <code>C:/Users/cf55611/ai2/pogodynka/templates/text_input/index.html.twig</code></li>
    </ul>
</div>
{% endblock %}
